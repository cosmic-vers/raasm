# Copy this file to .env and fill in real values before running the app.

# --- Database ---
# Use a hosted Postgres database (needed for real concurrent traffic -
# SQLite can't handle many simultaneous bookings). Free tiers that work well:
# Neon (neon.tech), Supabase (supabase.com), or Railway (railway.app).
#
# IMPORTANT for handling real traffic: use the POOLED connection string for
# DATABASE_URL, and the DIRECT (non-pooled) one for DIRECT_URL. Without this,
# a burst of concurrent visitors can exhaust your database's connection limit
# and start throwing errors.
#   Neon: in the dashboard's Connection Details, toggle "Pooled connection"
#         on for DATABASE_URL (hostname will contain "-pooler"), off for
#         DIRECT_URL.
#   Supabase: Project Settings > Database > Connection string > use the
#         "Transaction" pooler mode (port 6543) for DATABASE_URL, and the
#         direct connection (port 5432) for DIRECT_URL.
#   Railway's built-in Postgres doesn't pool by default - if you use it, add
#         "?connection_limit=10" to the end of DATABASE_URL as a simple cap
#         instead, and set DIRECT_URL to the same value.
DATABASE_URL="postgresql://postgres:oKFGtfJgkNoqGfeDEVXAlecvyWltVxOs@postgres.railway.internal:5432/railway"
DIRECT_URL="postgresql://postgres:oKFGtfJgkNoqGfeDEVXAlecvyWltVxOs@postgres.railway.internal:5432/railway?sslmode=require"

# --- NextAuth (admin login) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET="N7WnwdSu15QoQiQa7ZX9NRdIEyTmm2sC/YE621Oks90="
NEXTAUTH_URL="http://localhost:3000"

# --- First admin account (used by the seed script) ---
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="changeme123"

# --- Razorpay (get test keys from https://dashboard.razorpay.com/app/keys) ---
RAZORPAY_KEY_ID="rzp_test_xxxxxxxx"
RAZORPAY_KEY_SECRET="your_test_key_secret"
# Set this up under Razorpay Dashboard > Settings > Webhooks once you have a
# public URL, pointing at https://yourdomain.com/api/razorpay/webhook,
# subscribed to "payment.captured". This is now the RELIABLE payment
# confirmation path - don't skip it before going live.
RAZORPAY_WEBHOOK_SECRET=""

# --- Ticket QR signing (any long random string, same generation method as above) ---
TICKET_SECRET="2XAEuPsbwAFKmylzXPxNoJHISWKdQF+nQmbJHkwUhc0="

# --- Cloudinary (optional but recommended before deploying) ---
# Free account at cloudinary.com. Without these, uploaded images save to
# local disk, which will NOT survive on most hosting platforms.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Buyer login session signing (any long random string) ---
BUYER_SESSION_SECRET="l/bZp4Ld8byF7ecQTzaH0vAEyXYlEzcyxriVxD8dTFA="

# --- Firebase Phone Auth (buyer login by phone number) ---
# 1. Create a project at https://console.firebase.google.com (free Spark plan works)
# 2. Build > Authentication > Sign-in method > enable "Phone"
# 3. Authentication > Settings > Authorized domains > add your real domain
#    (localhost is allowed by default for testing)
# 4. Project settings > General > "Your apps" > add a Web app > copy these:
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyCqzz5uQ7pnTt0x7jFAzhM1GAVoCWa6RRI"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="raas-mahotsav.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="raas-mahotsav"
# 5. Project settings > Service accounts > Generate new private key (downloads
#    a JSON file). Copy three fields from it into these three server-only vars:
FIREBASE_PROJECT_ID="raas-mahotsav"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-fbsvc@raas-mahotsav.iam.gserviceaccount.com"
