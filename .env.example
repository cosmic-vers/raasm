# Copy this file to .env and fill in real values before running the app.
# NEVER put real secrets in this file (.env.example) - it's meant to be
# committed to git as a template. Real values go only in .env, which is
# git-ignored.

# --- Database ---
# Use a hosted Postgres database (needed for real concurrent traffic -
# SQLite can't handle many simultaneous bookings). Free tiers that work well:
# Neon (neon.tech), Supabase (supabase.com), or Railway (railway.app).
#
# IMPORTANT for handling real traffic: use the POOLED connection string for
# DATABASE_URL, and the DIRECT (non-pooled) one for DIRECT_URL.
#   Neon: in the dashboard's Connection Details, toggle "Pooled connection"
#         on for DATABASE_URL (hostname will contain "-pooler"), off for
#         DIRECT_URL.
DATABASE_URL="postgresql://user:password@host-pooler:5432/dbname?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# --- NextAuth (admin login) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# --- First admin account (used by the seed script) ---
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="changeme123"

# --- Razorpay (get test keys from https://dashboard.razorpay.com/app/keys) ---
RAZORPAY_KEY_ID="rzp_test_xxxxxxxx"
RAZORPAY_KEY_SECRET="your_test_key_secret"
RAZORPAY_WEBHOOK_SECRET=""

# --- Ticket QR signing (any long random string, same generation method as above) ---
TICKET_SECRET="replace-with-another-long-random-string"

# --- Buyer login session signing (any long random string) ---
BUYER_SESSION_SECRET="replace-with-yet-another-long-random-string"

# --- Cloudinary (optional but recommended before deploying) ---
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Firebase (buyer login via Google + email link) ---
# 1. Create a project at https://console.firebase.google.com (free Spark plan works)
# 2. Build > Authentication > Sign-in method > enable "Google"
# 3. Same page > enable "Email/Password" > toggle on "Email link (passwordless sign-in)"
# 4. Authentication > Settings > Authorized domains > add your real deployed domain
#    (localhost is allowed by default for testing)
# 5. Project settings > General > "Your apps" > add a Web app > copy these:
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
# 6. Project settings > Service accounts > Generate new private key (downloads
#    a JSON file). Copy three fields from it into these three server-only vars:
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
# Note: both Google and email-link sign-in are free on Firebase's Spark
# (no-billing) plan - unlike phone/SMS auth, no upgrade needed.
